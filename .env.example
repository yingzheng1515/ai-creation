# Preferred vendor stack
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Google/Gemini powers image and video generation.
# GEMINI_API_KEY is also accepted if you prefer that variable name.
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image-preview
GOOGLE_VIDEO_MODEL=veo-3.1-generate-preview
GOOGLE_VIDEO_POLL_DELAY_MS=1500

# Legacy fallback only. New deployments should prefer GOOGLE_API_KEY above.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
# SEEDANCE_API_KEY=
# SEEDANCE_API_URL=
# SEEDANCE_STATUS_API_URL=
# SEEDANCE_MODEL=seedance-2.0

# Optional generic REST fallback
AI_SCRIPT_API_URL=
AI_SCRIPT_API_KEY=
AI_IMAGE_API_URL=
AI_IMAGE_API_KEY=
AI_VIDEO_API_URL=
AI_VIDEO_API_KEY=
